<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definitions for types the system database may not have.
     Installed to /usr/share/mime/packages/ (update-mime-database runs on install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-smpl3d">
    <comment>Smpl3D design</comment>
    <icon name="io.tangencylabs.smpl3d"/>
    <sub-class-of type="application/json"/>
    <!-- shared-mime-info also gives *.sc to Scala scripts (text/x-scala, weight 50); with
         Smpl3D installed its designs win. -->
    <glob pattern="*.sc" weight="60"/>
    <!-- Compatibility shim (docs/compatibility.md): designs saved before .sc, and before the rename. -->
    <glob pattern="*.smpl3d"/>
    <glob pattern="*.solvecraft"/>
    <alias type="application/x-solvecraft"/>
  </mime-type>
</mime-info>
