<?xml version="1.0" encoding="utf-8"?>
<!--
  Smpl3D MSI (WiX Toolset v5, plus the UI and Util extensions). Built by package.ps1:

    wix build smpl3d.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc smpl3d.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install with a setup wizard: Welcome, install folder (Program Files\Smpl3D by
  default, remembered for upgrades), Ready, progress, and a Finish page with a ticked "Launch
  Smpl3D" box. Installs a Start Menu shortcut, smpl3d-cli (and adds its folder to the system PATH), the licence files (including
  THIRD-PARTY-LICENSES.txt), makes Smpl3D the owner of `.sc` (and of the older `.smpl3d` and pre-rename `.solvecraft`), and offers it under
  "Open with" for STEP, IGES, 3MF and STL. `msiexec /qn` installs silently.
  Adapted from PhotoCraft's (storytold/photocraft, Apache-2.0; see ATTRIBUTION.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Never change the UpgradeCode: it is what lets a new MSI replace every earlier install,
       including those from before the SolveCraft -> Smpl3D rename (docs/compatibility.md). -->
  <Package
      Name="Smpl3D"
      Manufacturer="Smpl3D contributors"
      Version="$(var.Version)"
      UpgradeCode="6A145FD6-D285-428D-AE84-A69570CDF4DB"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Smpl3D parametric 3D CAD" Manufacturer="Smpl3D contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Smpl3D is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Advertised shortcuts to an .exe need an .exe icon identifier (ICE50). -->
    <Icon Id="Smpl3dIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="Smpl3dIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://docs.smpl3d.io/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/bherbruck/smpl3d/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bherbruck/smpl3d/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Smpl3D" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by Smpl3dApp). -->
    <!-- Since the rename the folder and this key say Smpl3D. A pre-rename install recorded
         Software\SolveCraft, which isn't read: its upgrade (same UpgradeCode) removes the old
         folder and installs into Program Files\Smpl3D (docs/compatibility.md). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Smpl3D" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Smpl3D" Level="1">
      <ComponentGroupRef Id="Smpl3dFiles" />
    </Feature>

    <!-- WixUI_InstallDir without its licence page (MIT OR Apache-2.0: nothing to accept). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSmpl3d"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="Smpl3dVersion" Value="$(var.DisplayVersion)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Smpl3D $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Smpl3D" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#Smpl3dExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user. -->
    <CustomAction Id="LaunchSmpl3d" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="Smpl3dFiles" Directory="INSTALLFOLDER">
      <!-- A new GUID with the rename: the key file changed from solvecraft.exe to smpl3d.exe.
           The UpgradeCode above is unchanged, so this MSI major-upgrades a pre-rename install. -->
      <Component Id="Smpl3dApp" Guid="A379D509-D776-4B34-A3A4-71FBF5724971">
        <File Id="Smpl3dExe" Source="$(var.BinDir)\smpl3d.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Smpl3D"
              Description="Smpl3D parametric 3D CAD" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="Smpl3dIcon.exe" IconIndex="0" />
        </File>

        <!-- .sc: Smpl3D's own format; Smpl3D is its default app. -->
        <ProgId Id="Smpl3d.Design" Description="Smpl3D Design" Icon="Smpl3dExe" IconIndex="0">
          <Extension Id="sc" ContentType="application/x-smpl3d">
            <Verb Id="open" Command="Open" TargetFile="Smpl3dExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Compatibility shim (docs/compatibility.md): designs saved as .smpl3d (before .sc)
             and as .solvecraft (before the rename) open as the same ProgId. Registered by hand: a
             second Extension under one ProgId would write its open verb twice (WIX0091). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.smpl3d" Value="Smpl3d.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.smpl3d" Name="Content Type" Value="application/x-smpl3d" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Value="Smpl3d.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Name="Content Type" Value="application/x-solvecraft" Type="string" />
        <!-- STEP, IGES and meshes: offered under "Open with", never forced as the default. -->
        <ProgId Id="Smpl3d.Model" Description="3D model" Icon="Smpl3dExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Smpl3d.Model\shell\open\command" Value="&quot;[#Smpl3dExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.step\OpenWithProgids" Name="Smpl3d.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stp\OpenWithProgids" Name="Smpl3d.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.igs\OpenWithProgids" Name="Smpl3d.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.iges\OpenWithProgids" Name="Smpl3d.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.3mf\OpenWithProgids" Name="Smpl3d.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stl\OpenWithProgids" Name="Smpl3d.Model" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "smpl3d"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe" Name="FriendlyAppName" Value="Smpl3D" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\shell\open\command" Value="&quot;[#Smpl3dExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".sc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".smpl3d" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".solvecraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".step" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".stp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".igs" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".iges" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".3mf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\smpl3d.exe\SupportedTypes" Name=".stl" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\smpl3d.exe" Value="[#Smpl3dExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Smpl3D" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="Smpl3dCli">
        <File Id="Smpl3dCliExe" Source="$(var.BinDir)\smpl3d-cli.exe" KeyPath="yes" />
        <!-- The install folder on the system PATH, so MCP clients and shells find `smpl3d-cli` by name;
             removed again on uninstall. -->
        <Environment Id="Smpl3dPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <!-- Compatibility shim (docs/compatibility.md): the old CLI name, forwarding to smpl3d-cli. -->
      <Component Id="Smpl3dCliAlias">
        <File Id="SolvecraftCliAliasExe" Source="$(var.BinDir)\solvecraft-cli.exe" KeyPath="yes" />
      </Component>
      <!-- Several unversioned files: an explicit GUID (WIX0367). -->
      <Component Id="Smpl3dLicences" Guid="CDEDEE8D-4BE9-4872-A2EA-EE623A6C7E91">
        <File Id="LicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
        <File Id="LicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" />
        <File Id="Notice" Source="$(var.BinDir)\NOTICE" />
        <File Id="ThirdParty" Source="$(var.BinDir)\THIRD-PARTY-LICENSES.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
